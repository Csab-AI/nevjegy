    <div id="action-bar">
        <button class="action-btn red" onclick="showInfo('PORTFÓLIÓ', 'Egészségügyi AI projektek\nKórházi diagnózis rendszerek\nGenomika · MRI analízis\ngithub.com/kovacs-ai')">◈ PORTFÓLIÓ</button>
        <button class="action-btn" onclick="showInfo('KAPCSOLAT', 'ai@kovacs.dev\n+36 XX XXX XXXX\nLinkedIn: kovacs-ai-gabor\nBudapest, Magyarország')">⬡ KAPCSOLAT</button>
        <button class="action-btn purple" onclick="showInfo('GITHUB', '47 repository\nNeurális hálózatok\nPython · PyTorch · LangChain\ngithub.com/kovacs-ai')">◻ GITHUB</button>
    </div>
</div>

<!-- Splash képernyő -->
<div id="splash">
    <div class="splash-logo">KOVÁCS<br>AI-GÁBOR</div>
    <div class="splash-sub">// LEAD AI ENGINEER · NEURAL ARCHITECT //</div>
    <button id="start-btn" onclick="startAR()">⬡ AR NÉVJEGY INDÍTÁSA</button>
    <div class="permission-note">Kamera hozzáférés szükséges.<br>Az adatok nem kerülnek tárolásra.</div>
</div>

<!-- Hiba -->
<div id="error-msg">
    <h2>// KAMERA HIBA</h2>
    <p>A böngésző nem engedélyezte a kamera hozzáférést.<br><br>
    Engedélyezd a kamerát a beállításokban,<br>majd töltsd újra az oldalt.<br><br>
    iOS: Beállítások → Safari → Kamera → Engedélyezés</p>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
// ═══════════════════════════════════════════════════
// GLOBÁLIS ÁLLAPOT
// ═══════════════════════════════════════════════════
let scene, camera, renderer;
let hologramGroup, nameGroup, ringGroup, particleSystem;
let mouseX = 0, mouseY = 0;
let targetRotX = 0, targetRotY = 0;
let currentRotX = 0, currentRotY = 0;
let gyroAvailable = false;
let touchStartX = 0, touchStartY = 0;
let infoTimer = null;
let animFrameId;

// ═══════════════════════════════════════════════════
// AR INDÍTÁS
// ═══════════════════════════════════════════════════
async function startAR() {
    try {
        const constraints = {
            video: {
                facingMode: { ideal: 'environment' }, // hátsó kamera
                width: { ideal: 1920 },
                height: { ideal: 1080 }
            },
            audio: false
        };

        const stream = await navigator.mediaDevices.getUserMedia(constraints);
        const video = document.getElementById('camera-bg');
        video.srcObject = stream;

        // Ellenőrzés: tényleg hátsó kamera-e
        const track = stream.getVideoTracks()[0];
        const settings = track.getSettings();
        if (settings.facingMode === 'user') {
            video.style.transform = 'scaleX(-1)'; // front cam tükrözés
            document.getElementById('cam-label').textContent = 'ELSŐ';
        } else {
            video.style.transform = 'none';
        }

        // Gyro kísérlet
        setupGyro();

        // Three.js jelenet
        initThree();
        animate();

        // HUD megjelenítés
        document.getElementById('hud').classList.add('visible');

        // Splash eltüntetés
        const splash = document.getElementById('splash');
        splash.classList.add('hidden');
        setTimeout(() => splash.style.display = 'none', 900);

        // Óra
        setInterval(() => {
            const t = new Date().toTimeString().slice(0,5);
            const el = document.getElementById('clock-stat');
            if (el) el.textContent = t;
        }, 1000);

    } catch (err) {
        console.error('Kamera hiba:', err);
        document.getElementById('error-msg').classList.add('show');
        document.getElementById('splash').style.display = 'none';
    }
}

// ═══════════════════════════════════════════════════
// GYRO ÉRZÉKELŐ
// ═══════════════════════════════════════════════════
function setupGyro() {
    if (typeof DeviceOrientationEvent !== 'undefined') {
        // iOS 13+ engedélykérés
        if (typeof DeviceOrientationEvent.requestPermission === 'function') {
            DeviceOrientationEvent.requestPermission()
                .then(state => {
                    if (state === 'granted') enableGyro();
                })
                .catch(() => {});
        } else {
            enableGyro();
        }
    }
}

function enableGyro() {
    let lastBeta = null, lastGamma = null;
    window.addEventListener('deviceorientation', (e) => {
        if (e.beta === null) return;
        gyroAvailable = true;
        const beta = e.beta;   // -180 to 180 (elő-hátra dőlés)
        const gamma = e.gamma; // -90 to 90 (oldal dőlés)

        // Normalizálás: telefon függőlegesen tartva = 0
        targetRotX = THREE.MathUtils.clamp((beta - 80) * 0.015, -0.6, 0.6);
        targetRotY = THREE.MathUtils.clamp(gamma * 0.02, -0.8, 0.8);
    });
}

// ═══════════════════════════════════════════════════
// TOUCH VEZÉRLÉS (gyro nélkül)
// ═══════════════════════════════════════════════════
document.addEventListener('touchstart', (e) => {
    if (e.target.closest('#action-bar') || e.target.closest('#info-panel')) return;
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
}, { passive: true });

document.addEventListener('touchmove', (e) => {
    if (e.target.closest('#action-bar')) return;
    if (gyroAvailable) return; // gyro vezérel, touch nem kell
    const dx = e.touches[0].clientX - touchStartX;
    const dy = e.touches[0].clientY - touchStartY;
    targetRotY = THREE.MathUtils.clamp(dx * 0.004, -1.2, 1.2);
    targetRotX = THREE.MathUtils.clamp(dy * 0.003, -0.8, 0.8);
}, { passive: true });

// ═══════════════════════════════════════════════════
// THREE.JS JELENET INIT
// ═══════════════════════════════════════════════════
function initThree() {
    const canvas = document.getElementById('ar-canvas');
    const W = window.innerWidth;
    const H = window.innerHeight;

    // Renderer – átlátszó háttér (kamera látszik alatta)
    renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        premultipliedAlpha: false
    });
    renderer.setSize(W, H);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setClearColor(0x000000, 0); // teljesen átlátszó

    // Jelenet
    scene = new THREE.Scene();

    // Kamera
    camera = new THREE.PerspectiveCamera(60, W / H, 0.1, 100);
    camera.position.set(0, 0, 5);

    // Fények
    scene.add(new THREE.AmbientLight(0x001122, 0.8));
    const cyanLight = new THREE.PointLight(0x00ffcc, 2, 10);
    cyanLight.position.set(-2, 2, 3);
    scene.add(cyanLight);
    const purpleLight = new THREE.PointLight(0x8a2be2, 1.5, 10);
    purpleLight.position.set(2, -1, 2);
    scene.add(purpleLight);
    const redLight = new THREE.PointLight(0xff0055, 1, 8);
    redLight.position.set(0, -2, 1);
    scene.add(redLight);

    // Fő csoport (ez fog dőlni gyróval)
    hologramGroup = new THREE.Group();
    scene.add(hologramGroup);

    buildHologram();
    buildParticles();

    // Resize
    window.addEventListener('resize', () => {
        const W = window.innerWidth, H = window.innerHeight;
        camera.aspect = W / H;
        camera.updateProjectionMatrix();
        renderer.setSize(W, H);
    });
}

// ═══════════════════════════════════════════════════
// HOLOGRAM ÉPÍTÉS
// ═══════════════════════════════════════════════════
function buildHologram() {
    // ── Külső forgó gyűrűk ──
    ringGroup = new THREE.Group();
    hologramGroup.add(ringGroup);

    const ringMat1 = new THREE.MeshBasicMaterial({ color: 0x00ffcc, wireframe: false, transparent: true, opacity: 0.5, side: THREE.DoubleSide });
    const ringMat2 = new THREE.MeshBasicMaterial({ color: 0x8a2be2, transparent: true, opacity: 0.35, side: THREE.DoubleSide });
    const ringMat3 = new THREE.MeshBasicMaterial({ color: 0xff0055, transparent: true, opacity: 0.25, side: THREE.DoubleSide });

    const ring1 = new THREE.Mesh(new THREE.TorusGeometry(2.2, 0.012, 16, 120), ringMat1);
    ring1.rotation.x = Math.PI / 2;
    ringGroup.add(ring1);

    const ring2 = new THREE.Mesh(new THREE.TorusGeometry(1.8, 0.008, 16, 100), ringMat2);
    ring2.rotation.x = Math.PI * 0.4;
    ring2.rotation.z = Math.PI * 0.2;
    ringGroup.add(ring2);

    const ring3 = new THREE.Mesh(new THREE.TorusGeometry(1.5, 0.006, 16, 80), ringMat3);
    ring3.rotation.y = Math.PI * 0.3;
    ringGroup.add(ring3);

    // Kis gyűrű szegmensek (tick marks)
    for (let i = 0; i < 24; i++) {
        const angle = (i / 24) * Math.PI * 2;
        const seg = new THREE.Mesh(
            new THREE.BoxGeometry(0.04, 0.001, i % 6 === 0 ? 0.15 : 0.06),
            new THREE.MeshBasicMaterial({ color: 0x00ffcc, transparent: true, opacity: i % 6 === 0 ? 0.9 : 0.4 })
        );
        seg.position.set(Math.cos(angle) * 2.2, 0, Math.sin(angle) * 2.2);
        seg.lookAt(0, 0, 0);
        seg.rotation.y += Math.PI / 2;
        ring1.add(seg);
    }

    // ── Középső névjegy lap ──
    nameGroup = new THREE.Group();
    hologramGroup.add(nameGroup);

    // Névjegy alaplap (vékony box) – holografikus
    const cardGeo = new THREE.BoxGeometry(3.2, 1.8, 0.04);
    const cardMat = new THREE.MeshPhongMaterial({
        color: 0x001122,
        emissive: 0x001122,
        transparent: true,
        opacity: 0.55,
        shininess: 120,
        specular: 0x00ffcc
    });
    const card = new THREE.Mesh(cardGeo, cardMat);
    nameGroup.add(card);

    // Keret élek – wireframe box
    const edgesGeo = new THREE.EdgesGeometry(new THREE.BoxGeometry(3.22, 1.82, 0.045));
    const edgesMat = new THREE.LineBasicMaterial({ color: 0x00ffcc, transparent: true, opacity: 0.8 });
    const edges = new THREE.LineSegments(edgesGeo, edgesMat);
    nameGroup.add(edges);

    // Belső díszítő vonal (vízszintes)
    const lineMat = new THREE.LineBasicMaterial({ color: 0x00ffcc, transparent: true, opacity: 0.4 });
    const linePoints = [new THREE.Vector3(-1.4, 0.25, 0.025), new THREE.Vector3(1.4, 0.25, 0.025)];
    const lineGeo = new THREE.BufferGeometry().setFromPoints(linePoints);
    nameGroup.add(new THREE.Line(lineGeo, lineMat));

    // Sarokdíszek a kártyán
    [[1.4, 0.8], [-1.4, 0.8], [1.4, -0.8], [-1.4, -0.8]].forEach(([x, y]) => {
        const corner = new THREE.Group();
        corner.position.set(x, y, 0.025);
        const s = x > 0 ? 1 : -1;
        const sy = y > 0 ? 1 : -1;
        const h = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.012, 0.001), new THREE.MeshBasicMaterial({ color: 0x00ffcc, transparent: true, opacity: 0.8 }));
        h.position.x = -s * 0.09;
        const v = new THREE.Mesh(new THREE.BoxGeometry(0.012, 0.18, 0.001), new THREE.MeshBasicMaterial({ color: 0x00ffcc, transparent: true, opacity: 0.8 }));
        v.position.y = -sy * 0.09;
        corner.add(h, v);
        nameGroup.add(corner);
    });

    // ── Szöveg: Canvas textúra alapú ──
    addTextureText(nameGroup);

    // ── Lebegő hologram gömb felül ──
    const sphereGeo = new THREE.SphereGeometry(0.35, 32, 32);
    const sphereMat = new THREE.MeshPhongMaterial({
        color: 0x00ffcc,
        emissive: 0x00ffcc,
        emissiveIntensity: 0.3,
        transparent: true,
        opacity: 0.15,
        wireframe: false,
        shininess: 200
    });
    const sphere = new THREE.Mesh(sphereGeo, sphereMat);
    sphere.position.set(0, 1.55, 0);
    sphere.name = 'floatSphere';
    hologramGroup.add(sphere);

    // Gömb wireframe
    const sphereWire = new THREE.Mesh(
        new THREE.SphereGeometry(0.36, 16, 16),
        new THREE.MeshBasicMaterial({ color: 0x00ffcc, wireframe: true, transparent: true, opacity: 0.3 })
    );
    sphereWire.position.copy(sphere.position);
    sphereWire.name = 'floatSphereWire';
    hologramGroup.add(sphereWire);

    // Ikosaéder a gömb körül
    const ico = new THREE.Mesh(
        new THREE.IcosahedronGeometry(0.5, 0),
        new THREE.MeshBasicMaterial({ color: 0x8a2be2, wireframe: true, transparent: true, opacity: 0.4 })
    );
    ico.position.copy(sphere.position);
    ico.name = 'floatIco';
    hologramGroup.add(ico);

    // ── Adatoszlopok (skill vizualizáció) alul ──
    const skills = [0.92, 0.88, 0.95, 0.80, 0.97];
    const skillColors = [0x00ffcc, 0x8a2be2, 0x00ffcc, 0xff0055, 0x00ffcc];
    skills.forEach((val, i) => {
        const h = val * 0.8;
        const bar = new THREE.Mesh(
            new THREE.BoxGeometry(0.1, h, 0.1),
            new THREE.MeshPhongMaterial({ color: skillColors[i], emissive: skillColors[i], emissiveIntensity: 0.5, transparent: true, opacity: 0.6 })
        );
        bar.position.set(-1.0 + i * 0.5, -1.4 - h / 2, 0.025);
        bar.name = `bar${i}`;
        hologramGroup.add(bar);
    });

    // Data stream vonalak
    for (let i = 0; i < 6; i++) {
        const pts = [];
        for (let j = 0; j < 20; j++) pts.push(new THREE.Vector3((Math.random() - 0.5) * 6, (Math.random() - 0.5) * 4, (Math.random() - 0.5) * 2 - 1));
        const streamGeo = new THREE.BufferGeometry().setFromPoints(pts);
        const streamMat = new THREE.LineBasicMaterial({ color: i % 2 === 0 ? 0x00ffcc : 0x8a2be2, transparent: true, opacity: 0.06 });
        hologramGroup.add(new THREE.Line(streamGeo, streamMat));
    }
}

