<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>KOVÁCS AI-GÁBOR // AR NÉVJEGY</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Share+Tech+Mono&display=swap" rel="stylesheet">

    <style>
        :root {
            --cyan: #00ffcc;
            --purple: #8a2be2;
            --red: #ff0055;
            --dark: #020208;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: #000;
            overflow: hidden;
            width: 100vw;
            height: 100vh;
            font-family: 'Share Tech Mono', monospace;
            touch-action: none;
        }

        /* Kamera háttér */
        #camera-bg {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            object-fit: cover;
            z-index: 0;
            transform: scaleX(-1); /* tükrözés front cam esetén - hátsónál kikapcsoljuk JS-ből */
        }

        /* Three.js canvas */
        #ar-canvas {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            z-index: 10;
            pointer-events: none;
        }

        /* ── SPLASH KÉPERNYŐ ── */
        #splash {
            position: fixed;
            inset: 0;
            background: #000;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 24px;
            transition: opacity 0.8s ease;
        }
        #splash.hidden { opacity: 0; pointer-events: none; }

        .splash-logo {
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(22px, 6vw, 36px);
            font-weight: 900;
            color: var(--cyan);
            text-align: center;
            letter-spacing: 4px;
            text-shadow: 0 0 30px var(--cyan), 0 0 60px #00ffcc44;
            animation: titlePulse 2s ease-in-out infinite;
        }
        @keyframes titlePulse {
            0%, 100% { text-shadow: 0 0 20px var(--cyan), 0 0 40px #00ffcc44; }
            50% { text-shadow: 0 0 40px var(--cyan), 0 0 80px #00ffcc88, 0 0 120px #00ffcc22; }
        }

        .splash-sub {
            font-size: 11px;
            color: #ffffff44;
            letter-spacing: 3px;
            text-align: center;
        }

        #start-btn {
            font-family: 'Share Tech Mono', monospace;
            font-size: 13px;
            letter-spacing: 4px;
            color: var(--dark);
            background: var(--cyan);
            border: none;
            padding: 16px 40px;
            cursor: pointer;
            text-transform: uppercase;
            position: relative;
            overflow: hidden;
            transition: transform 0.15s;
            clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%);
        }
        #start-btn:active { transform: scale(0.97); }
        #start-btn::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, transparent 0%, #ffffff44 50%, transparent 100%);
            transform: translateX(-100%);
            animation: shimmer 2s infinite;
        }
        @keyframes shimmer { to { transform: translateX(200%); } }

        .permission-note {
            font-size: 10px;
            color: #ffffff22;
            letter-spacing: 2px;
            text-align: center;
            max-width: 260px;
            line-height: 1.8;
        }

        /* ── HUD RÉTEG ── */
        #hud {
            position: fixed;
            inset: 0;
            z-index: 20;
            pointer-events: none;
            opacity: 0;
            transition: opacity 1s ease 0.5s;
        }
        #hud.visible { opacity: 1; }

        /* Sarokdíszek */
        .corner {
            position: absolute;
            width: 28px; height: 28px;
            border-color: var(--cyan);
            border-style: solid;
            opacity: 0.6;
        }
        .c-tl { top: 16px; left: 16px; border-width: 2px 0 0 2px; }
        .c-tr { top: 16px; right: 16px; border-width: 2px 2px 0 0; }
        .c-bl { bottom: 16px; left: 16px; border-width: 0 0 2px 2px; }
        .c-br { bottom: 16px; right: 16px; border-width: 0 2px 2px 0; }

        /* Scanlaine */
        #scanline {
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--cyan), transparent);
            box-shadow: 0 0 10px var(--cyan);
            animation: scan 6s linear infinite;
            opacity: 0.5;
        }
        @keyframes scan { 0% { top: 0; } 100% { top: 100%; } }

        /* Felső státusz */
        #top-status {
            position: absolute;
            top: 20px; left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 20px;
            align-items: center;
        }
        .stat {
            font-size: 9px;
            color: #00ffcc66;
            letter-spacing: 2px;
        }
        .stat b { color: var(--cyan); }
        .dot {
            width: 5px; height: 5px;
            background: var(--cyan);
            border-radius: 50%;
            animation: blink 1.5s step-start infinite;
            box-shadow: 0 0 6px var(--cyan);
        }
        @keyframes blink { 50% { opacity: 0.1; } }

        /* Interaktív gombok – alul */
        #action-bar {
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 16px;
            pointer-events: all;
        }

        .action-btn {
            font-family: 'Share Tech Mono', monospace;
            font-size: 9px;
            letter-spacing: 2px;
            color: var(--cyan);
            background: #00ffcc11;
            border: 1px solid #00ffcc44;
            padding: 10px 18px;
            cursor: pointer;
            text-transform: uppercase;
            transition: all 0.2s;
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            clip-path: polygon(6px 0%, 100% 0%, calc(100% - 6px) 100%, 0% 100%);
        }
        .action-btn:active, .action-btn.active {
            background: #00ffcc33;
            border-color: var(--cyan);
            color: #fff;
            box-shadow: 0 0 16px #00ffcc44;
        }
        .action-btn.red { color: var(--red); border-color: #ff005544; background: #ff005511; }
        .action-btn.red:active { background: #ff005533; box-shadow: 0 0 16px #ff005544; }
        .action-btn.purple { color: var(--purple); border-color: #8a2be244; background: #8a2be211; }
        .action-btn.purple:active { background: #8a2be233; box-shadow: 0 0 16px #8a2be244; }

        /* Info panel – tap után jelenik meg */
        #info-panel {
            position: absolute;
            bottom: 110px;
            left: 50%;
            transform: translateX(-50%);
            background: #000000cc;
            border: 1px solid #00ffcc33;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 16px 24px;
            min-width: 260px;
            max-width: 90vw;
            text-align: center;
            clip-path: polygon(10px 0%, 100% 0%, calc(100% - 10px) 100%, 0% 100%);
            opacity: 0;
            transform: translateX(-50%) translateY(10px);
            transition: opacity 0.3s, transform 0.3s;
            pointer-events: none;
        }
        #info-panel.visible {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
        #info-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 11px;
            color: var(--cyan);
            letter-spacing: 3px;
            margin-bottom: 8px;
        }
        #info-body {
            font-size: 11px;
            color: #ffffffaa;
            letter-spacing: 1px;
            line-height: 1.8;
        }

        /* Gyro tipp */
        #gyro-tip {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            pointer-events: none;
            animation: fadeOutTip 3s ease 2s forwards;
        }
        @keyframes fadeOutTip { to { opacity: 0; } }
        #gyro-tip p {
            font-size: 11px;
            color: #ffffff44;
            letter-spacing: 3px;
        }

        /* Hiba üzenet */
        #error-msg {
            position: fixed;
            inset: 0;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 16px;
            z-index: 2000;
            background: #000000ee;
            padding: 32px;
            text-align: center;
        }
        #error-msg.show { display: flex; }
        #error-msg h2 {
            font-family: 'Orbitron', sans-serif;
            color: var(--red);
            font-size: 16px;
            letter-spacing: 3px;
        }
        #error-msg p {
            color: #ffffff66;
            font-size: 11px;
            letter-spacing: 2px;
            line-height: 2;
            max-width: 300px;
        }
    </style>
</head>
<body>

<!-- Kamera videó háttér -->
<video id="camera-bg" autoplay muted playsinline></video>

<!-- Three.js AR canvas -->
<canvas id="ar-canvas"></canvas>

<!-- HUD -->
<div id="hud">
    <div id="scanline"></div>
    <div class="corner c-tl"></div>
    <div class="corner c-tr"></div>
    <div class="corner c-bl"></div>
    <div class="corner c-br"></div>

    <div id="top-status">
        <div class="dot"></div>
        <div class="stat">AR <b>AKTÍV</b></div>
        <div class="stat">CAM <b id="cam-label">HÁTSÓ</b></div>
        <div class="stat" id="clock-stat">--:--</div>
        <div class="dot"></div>
    </div>

