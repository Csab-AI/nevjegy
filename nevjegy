// ═══════════════════════════════════════════════════
// RÉSZECSKE RENDSZER
// ═══════════════════════════════════════════════════
function buildParticles() {
    const count = 120;
    const positions = new Float32Array(count * 3);
    const colors = new Float32Array(count * 3);

    const palette = [[0, 1, 0.8], [0.54, 0.17, 0.89], [1, 0, 0.33]];

    for (let i = 0; i < count; i++) {
        positions[i * 3]     = (Math.random() - 0.5) * 10;
        positions[i * 3 + 1] = (Math.random() - 0.5) * 7;
        positions[i * 3 + 2] = (Math.random() - 0.5) * 5 - 2;
        const c = palette[Math.floor(Math.random() * 3)];
        colors[i * 3] = c[0];
        colors[i * 3 + 1] = c[1];
        colors[i * 3 + 2] = c[2];
    }

    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    particleSystem = new THREE.Points(geo, new THREE.PointsMaterial({
        size: 0.04,
        vertexColors: true,
        transparent: true,
        opacity: 0.7,
        sizeAttenuation: true
    }));
    scene.add(particleSystem);
}

// ═══════════════════════════════════════════════════
// ANIMÁCIÓ LOOP
// ═══════════════════════════════════════════════════
function animate() {
    animFrameId = requestAnimationFrame(animate);
    const t = Date.now() * 0.001;

    // Sima követés
    currentRotX += (targetRotX - currentRotX) * 0.08;
    currentRotY += (targetRotY - currentRotY) * 0.08;

    if (hologramGroup) {
        hologramGroup.rotation.x = currentRotX;
        hologramGroup.rotation.y = currentRotY;

        // Lebegő mozgás
        hologramGroup.position.y = Math.sin(t * 0.5) * 0.08;
    }

    // Gyűrűk saját forgása
    if (ringGroup) {
        ringGroup.rotation.y = t * 0.3;
        ringGroup.rotation.x = Math.sin(t * 0.2) * 0.15;
        ringGroup.children[0].rotation.z = t * 0.5;
        ringGroup.children[1].rotation.z = -t * 0.4;
    }

    // Gömb + iko
    const floatSphere = hologramGroup?.getObjectByName('floatSphere');
    const floatSphereWire = hologramGroup?.getObjectByName('floatSphereWire');
    const floatIco = hologramGroup?.getObjectByName('floatIco');
    if (floatSphere) {
        floatSphere.position.y = 1.55 + Math.sin(t * 1.2) * 0.08;
        floatSphere.rotation.y = t * 0.8;
    }
    if (floatSphereWire) {
        floatSphereWire.position.y = (floatSphere?.position.y) ?? 1.55;
        floatSphereWire.rotation.y = -t * 0.6;
        floatSphereWire.rotation.x = t * 0.3;
    }
    if (floatIco) {
        floatIco.position.y = (floatSphere?.position.y) ?? 1.55;
        floatIco.rotation.y = t * 1.1;
        floatIco.rotation.x = t * 0.7;
    }

    // Skill bárok pulzálása
    for (let i = 0; i < 5; i++) {
        const bar = hologramGroup?.getObjectByName(`bar${i}`);
        if (bar) {
            bar.material.emissiveIntensity = 0.3 + Math.sin(t * 2 + i * 0.8) * 0.3;
        }
    }

    // Részecskék lassú forgása
    if (particleSystem) {
        particleSystem.rotation.y = t * 0.02;
        particleSystem.rotation.x = Math.sin(t * 0.05) * 0.05;
    }

    renderer.render(scene, camera);
}

// ═══════════════════════════════════════════════════
// INFO PANEL
// ═══════════════════════════════════════════════════
function showInfo(title, body) {
    const panel = document.getElementById('info-panel');
    document.getElementById('info-title').textContent = '// ' + title + ' //';
    document.getElementById('info-body').innerHTML = body.replace(/\n/g, '<br>');
    panel.classList.add('visible');
    clearTimeout(infoTimer);
    infoTimer = setTimeout(() => panel.classList.remove('visible'), 5000);
}
